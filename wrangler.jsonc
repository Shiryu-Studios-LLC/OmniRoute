{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "omniroute-cloud-runtime",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "OMNIROUTE_ENV": "production",
  },
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "omniroute-cloud-runtime",
      "migrations_dir": "cloudflare/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "GATEWAY_ARTIFACTS",
      "bucket_name": "omniroute-cloud-gateway-artifacts",
      "preview_bucket_name": "omniroute-cloud-gateway-artifacts-preview",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GATEWAY_SESSIONS",
        "class_name": "GatewaySessionObject",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GatewaySessionObject"],
    },
  ],
}
